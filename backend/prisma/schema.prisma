generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ORGANIZER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         Role     @default(PLAYER)
  isBlocked    Boolean  @default(false) @map("is_blocked")
  createdAt    DateTime @default(now()) @map("created_at")

  tournaments     Tournament[]
  captainOfTeams  Team[]       @relation("TeamCaptain")
  teamMemberships TeamMember[]

  @@map("users")
}

enum TournamentFormat {
  ROUND_ROBIN
  SINGLE_ELIMINATION
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Tournament {
  id                   String           @id @default(uuid()) @db.Uuid
  organizerId          String           @map("organizer_id") @db.Uuid
  organizer            User             @relation(fields: [organizerId], references: [id])
  name                 String
  sport                String
  format               TournamentFormat
  location             String
  startDate            DateTime         @map("start_date") @db.Date
  registrationDeadline DateTime         @map("registration_deadline")
  maxTeams             Int              @map("max_teams")
  minPlayersPerTeam    Int              @map("min_players_per_team")
  pointsWin            Int              @default(3) @map("points_win")
  pointsDraw           Int              @default(1) @map("points_draw")
  pointsLoss           Int              @default(0) @map("points_loss")
  status               TournamentStatus @default(DRAFT)

  registrations Registration[]
  matches       Match[]

  @@map("tournaments")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  sport     String
  captainId String   @map("captain_id") @db.Uuid
  captain   User     @relation("TeamCaptain", fields: [captainId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  members         TeamMember[]
  registrations   Registration[]
  homeMatches     Match[]        @relation("MatchHome")
  awayMatches     Match[]        @relation("MatchAway")
  reportedMatches Match[]        @relation("MatchReporter")

  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@map("team_members")
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
}

model Registration {
  id           String             @id @default(uuid()) @db.Uuid
  tournamentId String             @map("tournament_id") @db.Uuid
  teamId       String             @map("team_id") @db.Uuid
  status       RegistrationStatus @default(PENDING)
  createdAt    DateTime           @default(now()) @map("created_at")
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@map("registrations")
}

enum MatchStatus {
  SCHEDULED
  AWAITING_CONFIRMATION
  CONFIRMED
  DISPUTED
  CANCELLED
}

enum MatchSlot {
  HOME
  AWAY
}

// Tekma. V izločilnem drevesu sta domača in gostujoča ekipa lahko null, dokler zmagovalca
// prejšnjih tekem ni; v prvem krogu away = null pomeni prosti prehod.
model Match {
  id               String      @id @default(uuid()) @db.Uuid
  tournamentId     String      @map("tournament_id") @db.Uuid
  round            Int
  position         Int
  homeTeamId       String?     @map("home_team_id") @db.Uuid
  awayTeamId       String?     @map("away_team_id") @db.Uuid
  scheduledAt      DateTime?   @map("scheduled_at")
  homeScore        Int?        @map("home_score")
  awayScore        Int?        @map("away_score")
  status           MatchStatus @default(SCHEDULED)
  reportedByTeamId String?     @map("reported_by_team_id") @db.Uuid
  nextMatchId      String?     @map("next_match_id") @db.Uuid
  nextMatchSlot    MatchSlot?  @map("next_match_slot")

  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeTeam        Team?      @relation("MatchHome", fields: [homeTeamId], references: [id])
  awayTeam        Team?      @relation("MatchAway", fields: [awayTeamId], references: [id])
  reportedByTeam  Team?      @relation("MatchReporter", fields: [reportedByTeamId], references: [id])
  nextMatch       Match?     @relation("NextMatch", fields: [nextMatchId], references: [id])
  previousMatches Match[]    @relation("NextMatch")

  @@index([tournamentId, round])
  @@map("matches")
}
