# Kopiraj to datoteko v .env (cp .env.example .env) in prilagodi vrednosti.


# PostgreSQL
POSTGRES_USER=turnirhub
POSTGRES_PASSWORD=spremeni-me
POSTGRES_DB=turnirhub

# Backend (host "db" je ime storitve v docker-compose.yaml)
DATABASE_URL=postgresql://turnirhub:spremeni-me@db:5432/turnirhub
JWT_SECRET=spremeni-me-v-dolg-nakljucen-niz
CLIENT_URL=http://localhost:5173

# Frontend (URL, na katerem brskalnik doseže API)
VITE_API_URL=http://localhost:3000
